# Anthropic API key (Phase 1 — external AI provider)
ANTHROPIC_API_KEY=your-api-key-here

# AI model to use (default: claude-haiku-4-5-20251001 for speed)
COMMIT_SAGE_MODEL=claude-haiku-4-5-20251001

# Max diff lines sent to AI (trimmed beyond this)
COMMIT_SAGE_MAX_DIFF_LINES=300

# Commit style: conventional (default) | freeform
COMMIT_SAGE_COMMIT_STYLE=conventional
